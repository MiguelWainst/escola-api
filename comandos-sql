create table cursos(
	id uuid primary key not null,
	nome varchar(70) not null,
	carga_horas decimal(4,1),
	data_criacao timestamp not null,
    data_atualizacao timestamp,
    usuario_atualizacao uuid
    descricao TEXT;
    capa_url VARCHAR(500);
)

create table professores(
	matricula numeric(6) primary key not null,
	nome varchar(70) not null,
	email varchar(50),
	data_nascimento date,
	cpf varchar(11),
	data_contratacao timestamp not null,
	data_atualizacao timestamp,
	usuario_atualizacao uuid
	id_usuario uuid unique references usuarios(id)
)

create table professores_cursos(
	matricula_professor numeric(6) not null,
	id_curso uuid not null,
	primary key(matricula_professor, id_curso),
	constraint fk_prof_curso_professor foreign key (matricula_professor) references professores(matricula),
	constraint fk_prof_curso_curso foreign key (id_curso) references cursos(id)
)

create table alunos(
	matricula numeric(6) primary key not null,
	nome varchar(70) not null,
	email varchar(50),
	data_nascimento date,
	cpf varchar(11),
	data_matricula timestamp not null,
	data_atualizacao timestamp,
	usuario_atualizacao uuid,
	id_curso uuid,
    id_usuario uuid unique references usuarios(id)

	constraint fk_aluno_curso foreign key (id_curso) references cursos(id)
)

create table usuarios(
	id uuid primary key not null,
	username varchar(50),
	email varchar(70),
	senha varchar(200),
	roles varchar[]
)

-- Cria a sequence começando em 100000 (garante 6 dígitos)
CREATE SEQUENCE professores_seq
  START WITH 100000
  INCREMENT BY 1
  MINVALUE 100000
  MAXVALUE 999999;

-- 1. Mudar na tabela cursos
ALTER TABLE cursos
  ALTER COLUMN usuario_atualizacao TYPE uuid USING usuario_atualizacao::uuid;

-- 2. Mudar na tabela professores
ALTER TABLE professores
  ALTER COLUMN usuario_atualizacao TYPE uuid USING usuario_atualizacao::uuid;